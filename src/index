  <script>
    var saveMode = false;
    var presetBtns = document.querySelectorAll('.preset-btn');
    var saveBtn = document.getElementById('save-btn');

    function hexToRgb(hex) {
      var r = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      return r ? {r:parseInt(r[1],16), g:parseInt(r[2],16), b:parseInt(r[3],16)} : null;
    }
    function rgbToHex(r, g, b) {
      return '#' + [r, g, b].map(function(x) {
        var hex = x.toString(16);
        return hex.length === 1 ? '0' + hex : hex;
      }).join('');
    }
    function send(url, cb) {
      var x = new XMLHttpRequest();
      x.open("GET", url, true);
      if (cb) x.onload = function() { if (x.status === 200) cb(x.responseText); };
      x.send();
    }

    function setColor() {
      var rgb = hexToRgb(document.getElementById('all-picker').value);
      send("/set-all-color?r="+rgb.r+"&g="+rgb.g+"&b="+rgb.b);
    }
    function setBrightness() {
      send("/set-brightness?brightness="+document.getElementById('brightness').value, pollStatus);
    }
    function setAnimation(v) { send("/set-animation?animation="+v); }
    function toggleLeds() { send("/toggle-all-leds", pollStatus); }
    function toggleAnimation() { send("/toggle-animation", pollStatus); }

    // Master power - toggles LEDs and light Kasa devices (excludes fans)
    var masterOn = false;
    var excludeFromMaster = ['Kris Room Fan'];

    function isLight(device) {
      return excludeFromMaster.indexOf(device.alias) === -1;
    }

    function toggleAllLights() {
      // Determine target state: if anything is on, turn all off; otherwise turn all on
      var ledsOn = document.getElementById('dot-leds').classList.contains('on');
      var anyLightOn = kasaDevices.some(function(d) { return d.state && d.online && isLight(d); });
      var targetState = !(ledsOn || anyLightOn);

      // Toggle LEDs if needed
      if (ledsOn !== targetState) {
        send("/toggle-all-leds", pollStatus);
      }

      // Toggle Kasa light devices that need to change (exclude fans)
      for (var i = 0; i < kasaDevices.length; i++) {
        var d = kasaDevices[i];
        if (d.online && isLight(d) && d.state !== targetState) {
          d.state = targetState;
          send("/kasa/toggle?id=" + i);
        }
      }
      renderKasaDevices();
    }

    function updateMasterPower() {
      var btn = document.getElementById('master-power');
      var ledsOn = document.getElementById('dot-leds').classList.contains('on');
      var anyLightOn = kasaDevices.some(function(d) { return d.state && d.online && isLight(d); });
      masterOn = ledsOn || anyLightOn;
      btn.classList.toggle('on', masterOn);
    }

    function toggleSaveMode() {
      saveMode = !saveMode;
      saveBtn.classList.toggle('active', saveMode);
      presetBtns.forEach(function(btn) {
        btn.classList.toggle('save-mode', saveMode);
      });
    }

    function presetClick(id) {
      if (saveMode) {
        send("/preset/save?id=" + id, function() {
          toggleSaveMode();
        });
      } else {
        send("/preset/load?id=" + id, pollStatus);
      }
    }

    // Kasa device management
    var kasaDevices = [];
    var kasaScanning = false;

    function kasaScan() {
      if (kasaScanning) return;
      kasaScanning = true;
      var container = document.getElementById('kasa-devices');
      container.innerHTML = '<div class="kasa-scanning">Scanning network...</div>';
      send("/kasa/scan", function(resp) {
        kasaScanning = false;
        var data = JSON.parse(resp);
        kasaDevices = data.devices || [];
        renderKasaDevices();
      });
    }

    function kasaToggle(id) {
      var dev = kasaDevices[id];
      if (!dev || !dev.online) return;
      // Optimistic update
      dev.state = !dev.state;
      renderKasaDevices();
      send("/kasa/toggle?id=" + id, function(resp) {
        var data = JSON.parse(resp);
        if (!data.success) {
          // Revert on failure
          dev.state = !dev.state;
          renderKasaDevices();
        }
      });
    }

    // Alias overrides for display names
    var aliasOverrides = {
      'Kris Studio Fan': 'Kris Studio Lamp'
    };

    function getDisplayName(alias) {
      return aliasOverrides[alias] || alias;
    }

    function renderKasaDevices() {
      var container = document.getElementById('kasa-devices');
      if (kasaDevices.length === 0) {
        container.innerHTML = '<div class="kasa-empty">No devices. Click "Scan" to discover.</div>';
        return;
      }
      var html = '';
      for (var i = 0; i < kasaDevices.length; i++) {
        var d = kasaDevices[i];
        var displayName = getDisplayName(d.alias);
        var offlineClass = d.online ? '' : ' kasa-device-offline';
        var toggleClass = d.state ? 'kasa-toggle on' : 'kasa-toggle';
        html += '<div class="kasa-device' + offlineClass + '">';
        html += '<div class="kasa-device-info">';
        html += '<span class="kasa-device-name">' + displayName + '</span>';
        html += '<span class="kasa-device-ip">' + d.ip + (d.online ? '' : ' (offline)') + '</span>';
        html += '</div>';
        html += '<div class="' + toggleClass + '" onclick="kasaToggle(' + i + ')"></div>';
        html += '</div>';
      }
      container.innerHTML = html;
      updateMasterPower();
    }

    function pollKasaDevices() {
      if (kasaDevices.length === 0) return;
      // Use cached endpoint - fast, non-blocking
      send("/kasa/devices", function(resp) {
        kasaDevices = JSON.parse(resp);
        renderKasaDevices();
      });
    }

    function kasaRefresh() {
      if (kasaDevices.length === 0) return;
      // Manual refresh - queries all devices, can be slow
      send("/kasa/refresh", function(resp) {
        kasaDevices = JSON.parse(resp);
        renderKasaDevices();
      });
    }

    // Status polling
    var dotOnline = document.getElementById('dot-online');
    var dotLeds = document.getElementById('dot-leds');
    var dotAnim = document.getElementById('dot-anim');
    var statusConn = document.getElementById('status-conn');
    var statusLeds = document.getElementById('status-leds');
    var statusAnim = document.getElementById('status-anim');

    function pollStatus() {
      var x = new XMLHttpRequest();
      x.open("GET", "/status", true);
      x.timeout = 3000;
      x.onload = function() {
        if (x.status === 200) {
          var s = JSON.parse(x.responseText);
          dotOnline.classList.add('online');
          statusConn.textContent = 'Online';
          if (s.ledsOn) {
            dotLeds.classList.add('on');
            statusLeds.textContent = 'LEDs On';
          } else {
            dotLeds.classList.remove('on');
            statusLeds.textContent = 'LEDs Off';
          }
          if (s.animating) {
            dotAnim.classList.add('anim');
            statusAnim.textContent = 'Anim On';
          } else {
            dotAnim.classList.remove('anim');
            statusAnim.textContent = 'Anim Off';
          }
          document.getElementById('brightness').value = s.brightness;
          document.getElementById('all-picker').value = rgbToHex(s.r, s.g, s.b);
          document.getElementById('animation').value = s.animation;
          updateMasterPower();
        }
      };
      x.onerror = x.ontimeout = function() {
        dotOnline.classList.remove('online');
        statusConn.textContent = 'Offline';
      };
      x.send();
    }
    pollStatus();
    setInterval(pollStatus, 5000);

    // Load saved Kasa devices on page load
    send("/kasa/devices", function(resp) {
      kasaDevices = JSON.parse(resp);
      if (kasaDevices.length > 0) {
        renderKasaDevices();
      }
    });
    // Poll Kasa device states every 30 seconds (uses cached state, fast)
    setInterval(pollKasaDevices, 30000);

    // Claude Status management
    var claudeEnabled = false;
    var claudeSessions = []; // From session tracker with name, state

    function claudeToggle() {
      var endpoint = claudeEnabled ? '/claude/disable' : '/claude/enable';
      send(endpoint, function(resp) {
        var data = JSON.parse(resp);
        if (data.success) {
          claudeEnabled = data.enabled;
          renderClaudeRows();
          // If enabling, ask session tracker to resync active sessions
          if (claudeEnabled) {
            var x = new XMLHttpRequest();
            x.open('GET', 'http://localhost:5544/resync', true);
            x.onload = function() { claudeRefresh(); };
            x.send();
          }
        }
      });
    }

    function claudeRefresh() {
      // First get enabled state from ESP32
      send('/claude/status', function(resp) {
        var data = JSON.parse(resp);
        claudeEnabled = data.enabled;

        // Then get session details from session tracker
        var x = new XMLHttpRequest();
        x.open('GET', 'http://localhost:5544/status', true);
        x.timeout = 2000;
        x.onload = function() {
          if (x.status === 200) {
            var trackerData = JSON.parse(x.responseText);
            claudeSessions = trackerData.rows || [];
          }
          renderClaudeRows();
        };
        x.onerror = x.ontimeout = function() {
          // Fallback to ESP32-only data
          claudeSessions = data.rows.map(function(state, i) {
            return { row: i, state: state, name: null };
          });
          renderClaudeRows();
        };
        x.send();
      });
    }

    function claudeResync() {
      // Resync session tracker state to ESP32 (doesn't clear anything)
      var x = new XMLHttpRequest();
      x.open('GET', 'http://localhost:5544/resync', true);
      x.onload = function() { claudeRefresh(); };
      x.send();
    }

    function getStateLabel(state) {
      switch(state) {
        case 'idle': return 'Idle';
        case 'thinking': return 'Working';
        case 'tool': return 'Working';
        case 'waiting': return 'Needs Attention';
        case 'error': return 'Error';
        default: return 'Offline';
      }
    }

    function renderClaudeRows() {
      var toggle = document.getElementById('claude-toggle');
      toggle.classList.toggle('on', claudeEnabled);

      var container = document.getElementById('claude-rows');
      if (!claudeEnabled) {
        container.innerHTML = '<div class="claude-empty">Claude mode disabled</div>';
        return;
      }

      // Filter to only show active sessions, reversed to match physical LED layout
      var activeSessions = claudeSessions.filter(function(s) { return s.state !== 'offline'; });
      activeSessions.sort(function(a, b) { return b.row - a.row; });

      if (activeSessions.length === 0) {
        container.innerHTML = '<div class="claude-empty">No active sessions</div>';
        return;
      }

      var html = '';
      for (var i = 0; i < activeSessions.length; i++) {
        var session = activeSessions[i];
        var name = session.name || ('Session ' + session.row);
        var state = session.state;
        var stateLabel = getStateLabel(state);
        html += '<div class="claude-row">';
        html += '<span class="claude-row-label">' + name + '</span>';
        html += '<div class="claude-state-info">';
        html += '<span class="claude-state-text ' + state + '">' + stateLabel + '</span>';
        html += '<div class="claude-state-dot ' + state + '"></div>';
        html += '</div>';
        html += '</div>';
      }
      container.innerHTML = html;
    }

    // Initial Claude status load and polling
    claudeRefresh();
    setInterval(claudeRefresh, 2000);

    // Build grid
    var grid = document.getElementById('led-grid');
    for (var i=4; i>=0; i--) {
      var row = document.createElement('div');
      row.className = 'led-grid-row';
      for (var j=59; j>=0; j--) {
        var btn = document.createElement('button');
        btn.dataset.x = j;
        btn.dataset.y = i;
        row.appendChild(btn);
      }
      grid.appendChild(row);
    }

    // Grid drawing
    var dragging = false;
    document.addEventListener('mouseup', function() { dragging = false; });
    grid.addEventListener('mousedown', function(e) {
      if (e.target.tagName === 'BUTTON') {
        dragging = true;
        send("/toggle-led?x="+e.target.dataset.x+"&y="+e.target.dataset.y);
      }
    });
    grid.addEventListener('mouseover', function(e) {
      if (dragging && e.target.tagName === 'BUTTON') {
        send("/toggle-led?x="+e.target.dataset.x+"&y="+e.target.dataset.y);
      }
    });
  </script>
</body>
</html>)rawliteral";
